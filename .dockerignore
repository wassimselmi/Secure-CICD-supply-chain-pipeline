# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Python cache / bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Tests (not needed in the runtime image) ──────────────────────────────────
test_app.py
tests/
.pytest_cache/
htmlcov/
.coverage

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Build / dist artifacts ────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Secrets / env files ───────────────────────────────────────────────────────
.env
*.env
*.pem
*.key

# ── Documentation (keeps image lean) ─────────────────────────────────────────
README.md
docs/

# ── CI/CD configs (not needed at runtime) ────────────────────────────────────
.github/
*.yml
*.yaml
Makefile
